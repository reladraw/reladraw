// Several links between the same two boxes with no side named anywhere. Each
// line is shifted sideways off the one a single link would draw, so they stay
// parallel and each end lands wherever its own line crosses the border.

diagram background: #111111

style box  fill: #191728  border: #4f5367

// Level boxes, so the run is horizontal and the lanes fan out vertically.
box a "A"  style: box
box b "B"  right of a (gap: wide)  level with a  style: box
link a -> b  "first"
link a -> b  "second"
link a -> b  "third"

// A perfect diagonal, where the single line would leave through the corner
// exactly. These two straddle it, one point on each of the edges meeting there.
box low  "Low"   below a (gap: wide)  left of a  style: box
box high "High"  above low  right of low (gap: wide)  style: box
link low -> high   "up"
link high -> low   "down"

// A near diagonal, where the crossing point sits on one edge but close to the
// corner.
box near "Near"  below low (gap: wide)  style: box
box far  "Far"   right of near (gap: wide)  above near  style: box
link near -> far  "one"
link near -> far  "two"

// A lone link is in no group and does not move.
box solo  "Solo"   below near (gap: wide)  style: box
box alone "Alone"  right of solo (gap: wide)  level with solo  style: box
link solo -> alone  "by itself"

// Naming a side on either end takes a link out of the group.
box named "Named"  below solo (gap: wide)  style: box
box other "Other"  right of named (gap: wide)  level with named  style: box
link named -> other  "free"
link named -> other  "free too"
link named -> other  "top"  from: top  to: top

// More than the edges can hold. The ends squeeze together and each line bows
// out in the middle to make up what its ends could not give it, so the labels
// still come apart. The middle line has no shortfall and stays straight.
box many "Many"  below named (gap: wide)  style: box
box one  "One"   right of many (gap: wide)  level with many  style: box
link many -> one  "first"
link many -> one  "second"
link many -> one  "third"
link many -> one  "fourth"
link many -> one  "fifth"

// The same on a vertical run, where the labels sit at one height and a lane is
// a whole label wide.
box top    "Top"     below many (gap: wide)  style: box
box bottom "Bottom"  below top (gap: wide)  style: box
link top -> bottom  "alpha"
link top -> bottom  "beta"
link top -> bottom  "gamma"
