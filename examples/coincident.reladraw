// Several links between the same two boxes with no side named anywhere.
//
// An unnamed end names no side to be spread along: it aims at the far box's
// center and attaches wherever that ray crosses the border, so every link
// between one pair produces the same ray and they are drawn on top of each
// other — one visible line, every label stacked on one point.
//
// The rule stays exactly what it was and only stops two links using it in the
// same place: the line a link would have drawn alone is translated sideways
// across its own run by a lane. The lines are therefore parallel, a lane
// apart, and where each end lands is whatever falls out of that.

diagram background: #111111

style box  fill: #191728  stroke: #4f5367

// Level boxes, so the run is horizontal and the lanes fan out vertically. All
// three attach along the same two edges, spread about the point the single
// link would have taken.
box a "A"  style: box
box b "B"  right of a (gap: wide)  level with a  style: box
link a -> b  "first"
link a -> b  "second"
link a -> b  "third"

// A perfect diagonal: equal boxes offset the same amount on both axes, so the
// one line a lone link would draw leaves through the corner exactly. Two links
// straddle it — one point slides onto each of the two edges meeting there —
// and the lines stay parallel.
box low  "Low"   below a (gap: wide)  left of a  style: box
box high "High"  above low  right of low (gap: wide)  style: box
link low -> high   "up"
link high -> low   "down"

// A near diagonal, where the crossing point sits on one edge but close to the
// corner. Whether both offsets stay on that edge or one crosses onto the next
// is arithmetic, not a case.
box near "Near"  below low (gap: wide)  style: box
box far  "Far"   right of near (gap: wide)  above near  style: box
link near -> far  "one"
link near -> far  "two"

// A lone unnamed link is in no group and is untouched: it still attaches where
// the center-to-center ray crosses the border.
box solo  "Solo"   below near (gap: wide)  style: box
box alone "Alone"  right of solo (gap: wide)  level with solo  style: box
link solo -> alone  "by itself"

// Naming a side on either end takes a link out of the group — it has a side to
// be spread along, and the existing rules own it.
box named "Named"  below solo (gap: wide)  style: box
box other "Other"  right of named (gap: wide)  level with named  style: box
link named -> other  "free"
link named -> other  "free too"
link named -> other  "top"  from: top  to: top

// More links than the edge can hold. Every one of them still has to attach
// somewhere on the same two edges, and those are only as tall as the boxes, so
// past a point there is nowhere further to spread. The ends squeeze evenly and
// each line makes up the shortfall in the middle instead, bowing across its own
// run by exactly what its ends could not give it — so the labels come apart
// even though the arrowheads crowd. The middle line has no shortfall and stays
// straight, which is what every group small enough for its boxes looks like.
box many "Many"  below named (gap: wide)  style: box
box one  "One"   right of many (gap: wide)  level with many  style: box
link many -> one  "first"
link many -> one  "second"
link many -> one  "third"
link many -> one  "fourth"
link many -> one  "fifth"

// The same thing on a vertical run, where the labels all sit at one height and
// so have to clear each other sideways. A lane is a whole label wide there,
// which two narrow boxes run out of far sooner.
box top    "Top"     below many (gap: wide)  style: box
box bottom "Bottom"  below top (gap: wide)  style: box
link top -> bottom  "alpha"
link top -> bottom  "beta"
link top -> bottom  "gamma"
