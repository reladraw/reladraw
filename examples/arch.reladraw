// A machine, backup and sync architecture overview.
// Transcribed by hand from a draw.io drawing.
// The reference render is examples/reference/arch.png.
//
// This file is the benchmark. It exists to be compared against that render,
// and to show up whatever the language cannot yet say.

// Color is written as the viewer receives it. The style name is what carries
// the meaning, so a diagram says `style: synced` and never a color directly.
style synced     fill: #142814  stroke: #486544  subtext: muted
style backup     stroke: #d2904e
// A dump is an artifact rather than a service, and the folded corner is what
// says so. Color alone cannot: the dark red means "a dump" only to someone who
// has already read the diagram, while a folded corner has meant "a document"
// for as long as there have been flowcharts.
style dump       fill: #460000  stroke: #4e4e4e  shape: document
style invisible  fill: none  stroke: none

// The page is nearly black in the reference, a shade below the containers so
// they read as regions sitting on it.
diagram  background: #111111


// --- the hub and its four machines ---------------------------------------
//
// The machines sit around Dropbox, and the whole cluster is wrapped in an
// invisible container so that things outside it can be placed against the
// cluster as a whole rather than against Dropbox alone.

box dropbox_and_machines ""  style: invisible

box dropbox_and_machines.dropbox "Dropbox"  icon: package  style: synced

box dropbox_and_machines.computer1       "Computer 1 / Ubuntu"    above-left of dropbox_and_machines.dropbox   gap: tight  icon: desktop
box dropbox_and_machines.computer1.files "\"important\" directory / Dropbox-synced"   style: synced

box dropbox_and_machines.computer3       "Computer 3 / Windows"   above-right of dropbox_and_machines.dropbox  gap: tight  icon: desktop
box dropbox_and_machines.computer3.files "\"important\" directory / Dropbox-synced"   style: synced

box dropbox_and_machines.computer2       "Computer 2 / Macbook"   below-left of dropbox_and_machines.dropbox   gap: tight  icon: laptop
box dropbox_and_machines.computer2.files "\"important\" directory / Dropbox-synced"   style: synced

box dropbox_and_machines.computer4       "Computer 4 / Macbook"   below-right of dropbox_and_machines.dropbox  gap: tight  icon: laptop
box dropbox_and_machines.computer4.files "\"important\" directory / Dropbox-synced"   style: synced

// Each machine's line leaves the side facing Dropbox and arrives on the top or
// bottom edge. Two arrive on each of those edges; nothing here says where along
// the edge, and they space themselves apart.
link dropbox_and_machines.computer1.files <-> dropbox_and_machines.dropbox  style: synced  from: right  to: top
link dropbox_and_machines.computer3.files <-> dropbox_and_machines.dropbox  style: synced  from: left   to: top
link dropbox_and_machines.computer2.files <-> dropbox_and_machines.dropbox  style: synced  from: right  to: bottom
link dropbox_and_machines.computer4.files <-> dropbox_and_machines.dropbox  style: synced  from: left   to: bottom


// --- the database dumps --------------------------------------------------
//
// The two dumps are one unit, so they get a container of their own and stack
// inside it without either of them stating a placement.
//
// Three placements, and no one target can supply all three. Horizontally the unit
// sits between Docker and the machine cluster; vertically it is level with
// Docker, which produces it.
//
// Nothing here says how wide the corridor between the server and the machines
// is. It does not need to: gaps are minimums, so stating that the dumps go in
// between is what pushes the two apart, and by exactly enough.
//
// The two sides do not want the same distance, though. The dumps come straight
// out of Docker, so they sit close to it; on the other side the two rclone
// curves have to fan out before they reach the machines, so that gap is wide.
// Each placement carries its own.

box dumps ""  right of server.docker  left of dropbox_and_machines (gap: wide)  level with server.docker  style: invisible
box dumps.db1 "pg_dump output / (DB 1)"  style: dump
box dumps.db2 "pg_dump output / (DB 2)"  style: dump

// The note explains what makes the dumps, so it is anchored under them.
note dumps_trigger "Triggered by `db-backup` shell command"  below dumps  gap: tight  width: 30


// --- the server ----------------------------------------------------------

box server         "My Server Machine"  left of dropbox_and_machines  icon: desktop  align: widths
box server.mirror  "\"important\" mirror"  style: backup
box server.deploy  "services deploy dir"  below server.mirror  gap: normal
// Docker holds services, and in the reference two of them are where the dump
// arrows actually start — the lines leave a cube's right face, not the wall of
// the box. So the cubes are nodes rather than ornament, and `shape: instance`
// draws each one as the glyph with no box around it. `icon: cubes` on the
// container would be claiming in decoration what the contents now say for real.
//
// Three of the five carry no meaning beyond "and others", which is why they are
// unnamed and unlabeled. The two that are the ends of arrows have names.
// The label's own modifiers ride in brackets on the label, the way a gap rides
// on the placement it belongs to — `at` and `align` say where this label goes
// and nothing else, and neither implies the other.
//
// The lower two cubes are each centered in the gap between two of the upper
// three, and that needs no construct of its own: a lone directional placement
// binds the other axis to its target's center line, and a placement naming two
// targets is about the region bounding both. So "below a and b" is "under the
// pair, centered between them" — which is exactly what the reference draws.
// Writing a second placement for the horizontal would drop that half and
// left-justify the row, which is what the first version of this did.
box server.docker  "Docker" (at: bottom, align: center)  below server.deploy  gap: normal
box server.docker.a    ""  shape: instance
box server.docker.b    ""  right of server.docker.a  gap: tight  shape: instance
box server.docker.db1  ""  right of server.docker.b  gap: tight  shape: instance
box server.docker.c    ""  below server.docker.a and server.docker.b    gap: tight  shape: instance
box server.docker.db2  ""  below server.docker.b and server.docker.db1  gap: tight  shape: instance

link server.deploy -> server.docker  "docker compose up"

// Each dump leaves the service that writes it and arrives on its own left edge.
// Nothing says where along an edge: the two arriving on Dropbox's left space
// themselves apart, and their order follows the layout.
link server.docker.db1 -> dumps.db1  from: right  to: left
link server.docker.db2 -> dumps.db2  from: right  to: left
// The two rclone lines climb into the channel between Computer 1 and Computer 2
// and run along it to Dropbox. That is how the architecture actually reads —
// the dumps arrive through the middle of the machines, not across one of them —
// and saying so is also what keeps the labels legible.
link dumps.db1 -> dropbox_and_machines.dropbox  "rclone"  between dropbox_and_machines.computer1 and dropbox_and_machines.computer2  from: right  to: left
link dumps.db2 -> dropbox_and_machines.dropbox  "rclone"  between dropbox_and_machines.computer1 and dropbox_and_machines.computer2  from: right  to: left

// Both leave the machine's left edge, which separates them and their labels.
// A link label breaks on ` / ` the same way a box label does.
link dropbox_and_machines.computer1.files -> server.mirror  "run `backup` / shell command"  style: backup  from: left  to: right
link dropbox_and_machines.computer1.files -> server.deploy  "run `deploy` / shell command"                 from: left  to: right


// --- the drives ----------------------------------------------------------

box ext_hd           "External HD"  above-left of server  icon: disk  align: widths
box ext_hd.important_backup  "\"important\" backup"      style: backup
box ext_hd.bare              "\"important\" bare clone"  style: backup
box ext_hd.archive1          "archive1"
box ext_hd.archive2          "archive2"

// Both leave the mirror's left edge and arrive on the drive's right edge, so
// neither cuts back across the server's own title.
link server.mirror -> ext_hd.important_backup  style: backup  from: left  to: right
link server.mirror -> ext_hd.bare  style: backup  from: left  to: right

box bup_hd           "BUP-HD1 / External Hard Drive"  below-left of ext_hd  icon: disk  align: widths
box bup_hd.important_backup  "\"important\" backup"
box bup_hd.bare              "\"important\" bare clone"
box bup_hd.archive1          "archive1"
box bup_hd.archive2          "archive2"
box bup_hd.storage           "long-term storage"

deck bup_hd "BUP-HD2" "BUP-HD3"

// A note goes beside the thing it explains, and "beside" means beside the rows
// it is about, not beside the drive as a whole. Naming two targets places the
// note against the box that just bounds them, so the first two need nothing
// said about their vertical position: it falls out of the region they name.
//
// The third wants its top edge against the long-term storage box rather than
// its center line, which is what the edge form of the alignment is for.

note rotations_note "Regular rotations backup \"important\" dir"  right of bup_hd.important_backup and bup_hd.bare  gap: tight  width: 28
note archive_note "archive dirs remain untouched"  left of bup_hd.archive1 and bup_hd.archive2  gap: tight  width: 26  overlap: allow
note storage_note "long-term storage is backed up only occasionally"  right of bup_hd.storage  top level with bup_hd.storage  gap: tight  width: 28
