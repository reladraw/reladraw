// A box with no text is labeled with its own name.

box parser
box resolver  right of parser
box renderer  right of resolver
link parser -> resolver "statements"
link resolver -> renderer "geometry"

// A dotted name shows only its last segment. The containment is already drawn.

box server  "My Server Machine"  below parser  gap: wide
box server.docker
box server.backup  right of server.docker  gap: tight

// Empty quotes are the other half: a box that is deliberately blank.

box pool ""  right of server (gap: wide)  level with server  fill: none  border: none
box pool.one    ""  shape: instance
box pool.two    ""  right of pool.one  gap: tight  shape: instance

// A stated label still wins.

box store "Records"  below pool.one and pool.two  gap: normal  icon: database
