// A node with no text of its own takes its name as its text.

node parser
node resolver  right of parser
node renderer  right of resolver
edge parser -> resolver "statements"
edge resolver -> renderer "geometry"

// A dotted name shows only its last segment. The containment is already drawn.

node server  "My Server Machine"  below parser  gap: wide
node server.docker
node server.backup  right of server.docker  gap: tight

// Empty quotes are the other half: a node that is deliberately blank.

node pool ""  right of server (gap: wide)  level with server  fill: none  border: none
node pool.one  icon: cube
node pool.two  right of pool.one  gap: tight  icon: cube

// A stated text still wins.

node store "Records"  below pool.one and pool.two  gap: normal  badge: database
