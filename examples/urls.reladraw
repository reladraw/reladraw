// `url:` makes a node or an edge clickable. The whole thing is the target — the
// box and everything drawn in it, or an edge's text — and nothing about it
// looks any different, because a destination is content rather than appearance
// and nothing else in the language lets content reach the ink.
//
// The value is quoted. Without the quotes everything from the `//` onwards is a
// comment, which is why the error for the bare form talks about punctuation.

style plain  fill: theme-fill  border: theme-border

node docs "Documentation"  style: plain  url: "https://example.com/docs"

// A container's destination reaches its children: `intro` has none of its own
// and follows the container, while `deep` overrules it inside its own box.
node site "Handbook" (inside top, align: left)  right of docs (gap: wide)  layout: column (align-children: left)  url: "https://example.com/"
node site.intro  "Introduction"  style: plain
node site.deep   "Deep dive"  style: plain  url: "https://example.com/deep"

// A picture and a bodiless node take one too. There is no kind that cannot.
node store  icon: database  below docs (gap: wide)  url: "https://example.com/store"
node aside  "and this line is a link as well"  shape: none  right of store  url: "https://example.com/aside"

// An edge's text is what carries the destination. An edge with no text may
// have one too: an unseen wider copy of the line takes the click.
edge docs -> store "read first"  from: bottom  to: top  url: "https://example.com/order"

// A long address is declared once under a name, with its name and badge, and
// used by that name. A declaration may also list several links, a bundle, and
// a `url:` mixes names and quoted addresses in the order written.
url orders-docs   "https://docs.example.com/orders/v2/reference/endpoints" (name: "Docs", icon: "D" (fill: #3a6ea5, text: white))
url orders-code   "https://github.com/example/orders/tree/main/services/api" (name: "Code", icon: "C")
url orders-links  orders-docs  orders-code  "https://wiki.example.com/teams/orders" (name: "Wiki")

node api     "Orders API"  style: plain  below store (gap: wide)  url: orders-links
node worker  "Worker"  style: plain  right of api  url: orders-docs  "https://example.com/runbooks/worker" (name: "Runbook")
