// Several links between the same two sides nest instead of crossing. The lanes
// are as wide as the labels riding in them.

diagram background: #111111

style box  fill: #191728  border: #4f5367

// A reciprocal pair around a corner. Further left along Gateway's bottom is
// further down Queue's left, so the order reverses between the two ends.
box gateway "Gateway"  style: box
box queue   "Queue"    below gateway  right of gateway (gap: wide)  style: box
link gateway -> queue  "publishes messages"  from: bottom  to: left
link queue -> gateway  "receives messages"   from: left    to: bottom

// Two edges facing each other, where the order runs the same way at both ends.
box client "Client"  below queue (gap: wide)  left of queue  style: box
box server "Server"  right of client (gap: wide)  level with client  style: box
link client -> server  "request"   from: right  to: left
link server -> client  "response"  from: left   to: right

// Five lanes down a vertical run. The labels all sit at the same height, so the
// only way they clear each other is sideways and a lane has to be a whole label
// wide. These two boxes are wide enough for five of them.
box fan  "Fan of five, spread wide"  below client (gap: wide)  left of client  style: box
box hub  "Hub of the same five"     below fan (gap: wide)  style: box
link fan -> hub  "one"    from: bottom  to: top
link fan -> hub  "two"    from: bottom  to: top
link fan -> hub  "three"  from: bottom  to: top
link fan -> hub  "four"   from: bottom  to: top
link fan -> hub  "five"   from: bottom  to: top

// Two links pointing the same way. Nothing tells them apart, so the order they
// are written in decides. Swap these two lines and the labels swap lanes.
box left_wall  "Producer"  below hub (gap: wide)  left of hub  style: box
box right_wall "Consumer"  right of left_wall (gap: wide)  level with left_wall  style: box
link left_wall -> right_wall  "bulk"     from: right  to: left
link left_wall -> right_wall  "control"  from: right  to: left

// Sharing one side only is not a bundle. The far ends differ, and that is
// enough to order them.
box spoke "Spoke"  below right_wall (gap: wide)  style: box
box up    "Up"     above spoke  right of spoke (gap: wide)  style: box
box down  "Down"   below spoke  right of spoke (gap: wide)  style: box
link spoke -> up    from: right  to: left
link spoke -> down  from: right  to: left

// More links than the two edges can hold. The arrowheads squeeze together
// because there is nowhere further along an edge to go, and each line makes up
// the shortfall by bowing out in the middle, where the labels ride.
box narrow "Narrow"  below spoke (gap: wide)  left of spoke  style: box
box also   "Also"    right of narrow (gap: wide)  level with narrow  style: box
link narrow -> also  "first"   from: right  to: left
link narrow -> also  "second"  from: right  to: left
link narrow -> also  "third"   from: right  to: left
link narrow -> also  "fourth"  from: right  to: left
link narrow -> also  "fifth"   from: right  to: left
