// A diagram that states no color of its own, so every color in it is the
// theme's. Render it in each theme to compare them.

style quiet  text: (color: theme-muted, size: small)

node web     "Web app"  badge: laptop
node api     "API server"                          10 right of web
node cluster "Workers" (inside top, align: left)  6 below api
node cluster.a "worker a"
node cluster.b "worker b"                          right of cluster.a (gap: tight)
node db      "Records"  icon: database             10 right of api
node note    "Backed up nightly / to cold storage"  below db  shape: none  style: quiet

edge web -> api "HTTPS"
edge api -> cluster "jobs"
edge api -> db "queries"
