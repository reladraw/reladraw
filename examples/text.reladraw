// An edge's text takes no room of its own: the gap it sits in is the one the
// placements say, so a text that needs room is given it by stating the gap.

style plain  fill: theme-fill  border: theme-border

// A `normal` gap is sized for two nodes to breathe, not to hold a word, so a
// word that needs more is given it by stating the gap, here in units.
node parser   "Parser"                           style: plain
node resolver "Resolver"  right of parser (gap: 10)  style: plain
edge parser -> resolver  "statements"  from: right  to: left

// Going downward the text is only a line deep, and it hangs out either side.
//
// Written with `<-`, which draws the same picture as `writer -> disk`. It just
// puts the node the line is about first. `from:` is still the first name
// written, so it names Disk's side.
node writer "Writer"  right of resolver (gap: wide)  style: plain
node disk   "Disk"    below writer (gap: wide)      style: plain
edge disk <- writer  "flushed to disk"  from: top  to: bottom

// Corner to corner, the text sits at the middle of the line, so the gap is
// stated on both axes.
node high "High"  right of writer (gap: wide)  style: plain
node low  "Low"   below high (gap: wide)  right of high (gap: wide)  style: plain
edge high -> low  "diagonal"


// --- What the brackets after a text say ------------------------------------
// A container's title says which side it sits against, and `align` where along
// that side, which also ranges its lines against each other.

style dim  text: (color: theme-muted)

node shelf "Shelf" (inside bottom, align: right)  below disk (gap: wide)  left even with parser  style: plain
node shelf.one "first"   style: plain
node shelf.two "second"  below shelf.one (gap: tight)  style: plain

// A box is usually the size of its own text. A picture beside the text is two
// lines tall, and lining the picture's top or bottom up with the text's puts
// the text at the top or bottom of the box. Joined to the text, the picture and
// the text are centered in the box together.
node tall "Top"     right of shelf (gap: wide)  style: plain
node tall.disk  icon: disk  1 right of tall text  top even with tall text  join-with: tall text
node deep "Bottom"  below tall (gap: tight)  style: plain
node deep.disk  icon: disk  1 right of deep text  bottom even with deep text  join-with: deep text

// Marked words take their style's size as well as its color. A line that is
// all small is spaced as a small line, and a small word mid-line sits on the
// same baseline as its neighbors.
style note  text: (size: small, color: theme-muted)
node synced "Shared folder / [note]synced 2 min ago[/note] / 3 [note]files[/note] waiting"  below deep (gap: tight)  style: plain

// `size` and `wrap` are properties of the text too. The wrap is a count of
// characters, not a distance: it says how much fits on a line and nothing
// about where anything sits.
node aside "A quiet remark that folds itself, with [dim]one word[/dim] quieter than the rest." (size: small, wrap: 28)  right of tall (gap: wide)  shape: none

// A literal bracket is written \[, since [ opens markup.
node literal "sizes \[small, normal, large]"  below aside (gap: tight)  shape: none

// An edge's text takes the same brackets. A size may be a multiple of normal,
// such as 1.2, or pixels, such as 12px, as well as a name.
edge tall -> aside  "carried" (color: theme-muted, size: 12px)  from: right  to: left

// `reads: up` or `down` turns a text a quarter turn, so a title on a left or
// right side takes a column one line wide rather than one word wide.
node rack "Rack" (inside left, reads: up)  right of aside (gap: wide)  top even with tall  layout: column (gap: tight)  style: plain
node rack.web "web"  style: plain
node rack.db  "db"   style: plain
