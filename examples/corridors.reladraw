// `between a and b` sends a link through the gap between two named things, for
// the stretch where it is passing them. Before and after, it goes wherever its
// ends take it.

diagram background: #111111

style channel  fill: #191920  border: #25242f

// North and South are apart vertically, so that is the gap. Both links start
// well to the left, climb into the channel, run along it and leave for East.
// They share it, so they take a lane each.

box west   "West"
box lower  "Lower"   below west     gap: tight
box north  "North"   right of west  gap: wide   style: channel
box south  "South"   below north    gap: wide   style: channel
box east   "East"    right of north and south  level with west  gap: wide

link west  -> east  "over"   between north and south  from: right  to: left
link lower -> east  "under"  between north and south  from: right  to: left

// Port and Starboard are apart horizontally, so here the line runs down the gap
// instead. This link names no sides: the open end aims at the channel rather
// than at the far box, so it leaves Bow already heading for the gap.

box bow        "Bow"        below lower  gap: wide
box port       "Port"       below bow    gap: wide       style: channel
box starboard  "Starboard"  right of port  level with port  gap: wide  style: channel
box stern      "Stern"      below port   gap: wide

link bow -> stern  "down"  between port and starboard

// The same channel travelled the other way. No label on this one, so its lane
// needs only the room two arrows need.

link stern -> bow  between port and starboard  from: top  to: bottom

// High and Low sit diagonally, so there are two gaps between them and the file
// has to say which. `vertically` is the gap you measure with a vertical ruler —
// under High, over Low — so a line running along it travels sideways.

box far   "Far"    below stern  gap: wide
box high  "High"   right of far  gap: wide  style: channel
box low   "Low"    below-right of high  gap: wide  style: channel
box near  "Near"   right of low  level with high  gap: wide

link far -> near  "threaded"  between high and low vertically
